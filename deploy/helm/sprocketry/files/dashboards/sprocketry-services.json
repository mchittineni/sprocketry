{
  "uid": "sprocketry-services",
  "title": "Sprocketry services",
  "tags": [
    "sprocketry"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(dapr_http_client_completed_count_total, app_id)",
          "refId": "service"
        },
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "allValue": ".+",
        "refresh": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests per second",
      "description": "Requests each service's sidecar delivered to it: service invocations and pub/sub messages. The storefront's browser traffic reaches it directly, not through its sidecar, so it is not counted here.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (app_id) (rate(dapr_http_client_completed_count_total{app_id=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{app_id}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Server error ratio (5xx)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (app_id) (rate(dapr_http_client_completed_count_total{app_id=~\"$service\", status=~\"5..\"}[$__rate_interval])) or sum by (app_id) (rate(dapr_http_client_completed_count_total{app_id=~\"$service\"}[$__rate_interval])) * 0) / sum by (app_id) (rate(dapr_http_client_completed_count_total{app_id=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{app_id}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency p95",
      "description": "Time from the sidecar handing a request to the app until the app answers.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (app_id, le) (rate(dapr_http_client_roundtrip_latency_bucket{app_id=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "{{app_id}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latency p50",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.5, sum by (app_id, le) (rate(dapr_http_client_roundtrip_latency_bucket{app_id=~\"$service\"}[$__rate_interval])))",
          "legendFormat": "{{app_id}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Service invocation calls",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (app_id, src_app_id) (rate(dapr_runtime_service_invocation_res_sent_total{app_id=~\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{src_app_id}} \u2192 {{app_id}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Orders topic",
      "description": "Messages published (payment) and delivered (fulfillment).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (app_id, topic) (rate(dapr_component_pubsub_egress_count_total[$__rate_interval])) or sum by (app_id, topic) (rate(dapr_component_pubsub_ingress_count_total[$__rate_interval]))",
          "legendFormat": "{{app_id}} {{topic}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 10
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=~\"($service)(-dapr)?\"}"
        }
      ],
      "description": "Each service's logs and its Dapr sidecar's."
    }
  ]
}