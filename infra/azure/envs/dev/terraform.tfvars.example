subscription_id = "00000000-0000-0000-0000-000000000000"
owner           = "you@example.com"
location        = "uksouth"

# Who may reach the AKS API: your IP (curl -s https://checkip.amazonaws.com) and CI's egress range.
aks_api_authorized_cidrs = ["203.0.113.10/32"]

# Object IDs of everyone who runs Terraform here, including the CI service principal.
# Yours: az ad signed-in-user show --query id -o tsv
deployer_principal_ids = ["00000000-0000-0000-0000-000000000000"]
