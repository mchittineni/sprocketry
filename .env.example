# Copy to .env to change the local stack. Every value here is the default.

# Host ports for the storefront, Grafana and Keycloak.
STOREFRONT_PORT=3000
GRAFANA_PORT=3001
KEYCLOAK_PORT=8081

# Where images come from. `make up` builds and tags them with these names;
# `make up-prebuilt` pulls them. Point REGISTRY at ghcr.io/<you>/<repo> to use your fork's images.
REGISTRY=ghcr.io/mchittineni/sprocketry
TAG=latest

DAPR_VERSION=1.18.9

# Fault injection, for practising observability and incident response. Payment's faults are flags that
# change while the stack runs: make fault (deploy/helm/sprocketry/files/flagd/faults.json).
DISPATCH_MAX_DELAY_MS=500   # upper bound of fulfillment's random dispatch delay
